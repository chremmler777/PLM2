   "LL_x0023_": "LL-0001",
   "ProjectName": "G6x",
   "ProjectNumber": 1748,
   "Customer": "BMW",
   "BusinessArea": "Tool Build (Mold)",
   "KeyTopic": "Sample Shipment Coverage",
   "IdentifiedIssue": "Sample amounts received from mold maker T3 builds is not enough to cover BMW VS0 requirements.",
   "NecessaryMeasures": "The quote package to each prospective toolmaker must include an agreed-upon amount of final samples that will be completed and shipped to the manufacturing facility in saleable condition.  This quantity must be determined by the project PM.",
   "InitiatorId": 6,
   "InitiatorStringId": "6",
   "Priority": "Critical",
   "Status": "Corrective Action Implemented",
   "EvidenceDocuments_x002f_Images": null,
   "ID": 1,
   "Modified": "2026-09-10T17:29:05Z",
   "Created": "2025-07-09T14:36:39Z",
