  },
  {
   "FileSystemObjectType": 0,
   "Id": 2,
   "ServerRedirectedEmbedUri": null,
   "ServerRedirectedEmbedUrl": "",
   "ContentTypeId": "0x010016C9C8E084BCF7418BF5969F74A73AA5003268B504D1BA514AAA7B19789BE0890A",
   "Title": null,
   "OData__ColorTag": null,
   "ComplianceAssetId": null,
   "LL_x0023_": "LL-0002",
   "ProjectName": "Atlas",
   "ProjectNumber": 1864,
   "Customer": "OP Mobility",
   "BusinessArea": "Sales",
   "KeyTopic": "Understanding specification requirements for Equipment",
   "IdentifiedIssue": "Tooling Equipment had unknown specifications (Technologies, Subinserts, Injection Technology, amount of needle valves). Tools were specified and built according to known Tier 1 regulations. The specification was unknown and additional technologies implemented.",
   "NecessaryMeasures": "Share the specifications and open claim towards supplier engineering if specifications need to get updated and require additional costs.",
   "InitiatorId": 11,
   "InitiatorStringId": "11",
   "Priority": "High",
   "Status": "Pending Review With Team",
   "EvidenceDocuments_x002f_Images": null,
   "ID": 2,
   "Modified": "2025-08-07T19:37:08Z",
   "Created": "2025-07-10T19:26:43Z",
   "AuthorId": 11,
   "EditorId": 6,
   "OData__UIVersionString": "2.0",
   "Attachments": false,
   "GUID": "67e9661d-7491-4789-abde-61ee86ca1e1e"
  },
  {
   "FileSystemObjectType": 0,
   "Id": 3,
   "ServerRedirectedEmbedUri": null,
   "ServerRedirectedEmbedUrl": "",
   "ContentTypeId": "0x010016C9C8E084BCF7418BF5969F74A73AA5003268B504D1BA514AAA7B19789BE0890A",
   "Title": null,
   "OData__ColorTag": null,
   "ComplianceAssetId": null,
   "LL_x0023_": "LL-0003",
   "ProjectName": "Atlas",
   "ProjectNumber": 1864,
   "Customer": "OP Mobility",
   "BusinessArea": "Project Team",
   "KeyTopic": "Availability during samplings and releases",
   "IdentifiedIssue": "External Samplings were performed in China and Mexico. China samplings had to happen without the support of internal personnel, leading into miscommunication and bad timing and quality performance. Promises from the Tier 1 to support the samplings turned out to be false. Canada samplings were performed and the need of technical personnel realized almost too late. Cost factor was not calculated proper. Responsible departments are not completely defined, leading into discussions of who has to go.",
   "NecessaryMeasures": "- Guarantee on sight support\n- Define responsible project members\n",
   "InitiatorId": 11,
   "InitiatorStringId": "11",
   "Priority": "Medium",
   "Status": "Open - In Progress",
   "EvidenceDocuments_x002f_Images": null,
   "ID": 3,
   "Modified": "2025-09-22T11:43:48Z",
   "Created": "2025-07-10T19:33:06Z",
   "AuthorId": 11,
   "EditorId": 6,
   "OData__UIVersionString": "3.0",
   "Attachments": false,
   "GUID": "46569a93-1d0f-4e90-8e75-69e8caef807f"
  },
  {
   "FileSystemObjectType": 0,
   "Id": 4,
   "ServerRedirectedEmbedUri": null,
   "ServerRedirectedEmbedUrl": "",
   "ContentTypeId": "0x010016C9C8E084BCF7418BF5969F74A73AA5003268B504D1BA514AAA7B19789BE0890A",
   "Title": null,
   "OData__ColorTag": null,
   "ComplianceAssetId": null,
   "LL_x0023_": "LL-0004",
   "ProjectName": "Volvo 723N",
   "ProjectNumber": 1687,
   "Customer": "Volvo",
   "BusinessArea": "Quality/ Development",
   "KeyTopic": "Wrong measurement system chose",
   "IdentifiedIssue": "Parts have been released in Weissenburg and deemed as OK, after 3D Scan. The issue was, that the measurement report was checked according to best fit. Customer requirement was alignment to RPS. On the gauge, with measurements according to RPS, 90% of the measurements have been out of spec. Followed by weeks of in depth analysis, countless samplings (18 different processes) and necessary tool changes (15.000$).",
   "NecessaryMeasures": "Do not release or accept measurement reports that are not aligned to customer specification.",
   "InitiatorId": 11,
   "InitiatorStringId": "11",
   "Priority": "Medium",
   "Status": "Pending Review With Team",
   "EvidenceDocuments_x002f_Images": null,
   "ID": 4,
   "Modified": "2025-08-07T19:37:24Z",
   "Created": "2025-07-10T20:13:49Z",
   "AuthorId": 11,
   "EditorId": 6,
   "OData__UIVersionString": "2.0",
   "Attachments": false,
   "GUID": "c3619c37-8083-4295-9863-d9c2c8ea3a14"
  },
  {
   "FileSystemObjectType": 0,
   "Id": 5,
   "ServerRedirectedEmbedUri": null,
   "ServerRedirectedEmbedUrl": "",
   "ContentTypeId": "0x010016C9C8E084BCF7418BF5969F74A73AA5003268B504D1BA514AAA7B19789BE0890A",
   "Title": null,
   "OData__ColorTag": null,
   "ComplianceAssetId": null,
   "LL_x0023_": "LL-0005",
   "ProjectName": "Volvo Tailgate Deco",
   "ProjectNumber": 1598,
   "Customer": "Volvo",
   "BusinessArea": "Assembly",
   "KeyTopic": "Welding marks on high gloss",
   "IdentifiedIssue": "Tailgate was high gloss painted and then assembled and welded in a form nest. 1.st Anti scratch (rubber) coating does not prevent the part from scratches as soon as the nest gets dirty. 2nd. Ultrasonic weld can melt the surface and leave different visual defects, leaving a tiny process window.",
   "NecessaryMeasures": "Avoid high gloss painting prior to assembly if possible. Design nests with minimal contact and plan for a auto blow off system. If welding is used, make sure the welding process can get fine tuned if welding sits below the visible surface. Incorporate sufficient cooling to prevent deformation. Also check for active air cooling on the visible area.",
   "InitiatorId": 11,
   "InitiatorStringId": "11",
   "Priority": "Low",
   "Status": "Pending Review With Team",
   "EvidenceDocuments_x002f_Images": null,
   "ID": 5,
   "Modified": "2025-08-07T19:37:29Z",
   "Created": "2025-07-10T20:19:34Z",
   "AuthorId": 11,
   "EditorId": 6,
   "OData__UIVersionString": "2.0",
   "Attachments": false,
   "GUID": "508837c0-f7af-41cd-8269-9c8b3393d19e"
  },
